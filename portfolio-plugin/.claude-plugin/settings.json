{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(mkdir*)",
      "Bash(ls*)",
      "Bash(mv ~/.portfolio/*)",
      "Bash(ln -sf*)",
      "Bash(rm ~/.portfolio/*)",
      "Bash(open*)",
      "Write(~/.portfolio/*)",
      "Read(~/.portfolio/*)",
      "Skill(stock-researcher:*)",
      "mcp__kite__login",
      "mcp__kite__get_profile",
      "mcp__kite__get_holdings",
      "mcp__kite__get_historical_data",
      "mcp__kite__search_instruments",
      "mcp__kite__get_ltp"
    ]
  }
}
